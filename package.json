{
    "name": "@romario-stankovic/ui",
    "version": "0.0.0",
    "private": true,
    "description": "UI library",
    "type": "module",
    "files": [
        "packages"
    ],
    "workspaces": [
        "packages/*"
    ],
    "exports": {
        "./react": {
            "types": "./packages/react/dist/index.d.ts",
            "import": "./packages/react/dist/index.js",
            "require": "./packages/react/dist/index.umd.cjs"
        },
        "./vue": {
            "types": "./packages/vue/dist/index.d.ts",
            "import": "./packages/vue/dist/index.js",
            "require": "./packages/vue/dist/index.umd.cjs"
        },
        "./vue/style.css": "./packages/vue/dist/index.css"
    },
    "scripts": {
        "dev": "concurrently \"npm run dev:mitosis\" \"npm run dev:storybook\"",
        "build": "npm run build:mitosis && npm run build:copy && npm run build:packages",
        "dev:mitosis": "watch \"npm run build:mitosis\" ./src",
        "dev:storybook": "storybook dev -p 6006 --no-open",
        "build:storybook": "storybook build",
        "build:mitosis": "mitosis build --c mitosis.config.cjs",
        "build:copy": "copyfiles -u 1 assets/**/* packages",
        "build:packages": "npm run build -ws",
        "lint": "eslint --fix",
        "format": "prettier --write .",
        "prepare": "npm run build"
    },
    "devDependencies": {
        "@builder.io/eslint-plugin-mitosis": "^0.0.17",
        "@builder.io/mitosis": "^0.7.1",
        "@builder.io/mitosis-cli": "^0.7.1",
        "@chromatic-com/storybook": "^3.2.5",
        "@eslint/eslintrc": "^3.3.0",
        "@eslint/js": "^9.22.0",
        "@fortawesome/fontawesome-svg-core": "^6.7.2",
        "@fortawesome/free-brands-svg-icons": "^6.7.2",
        "@fortawesome/free-regular-svg-icons": "^6.7.2",
        "@fortawesome/free-solid-svg-icons": "^6.7.2",
        "@fortawesome/react-fontawesome": "^0.2.2",
        "@iconify-icon/react": "^2.3.0",
        "@storybook/addon-essentials": "^8.6.4",
        "@storybook/addon-interactions": "^8.6.4",
        "@storybook/addon-onboarding": "^8.6.4",
        "@storybook/blocks": "^8.6.4",
        "@storybook/react": "^8.6.4",
        "@storybook/react-vite": "^8.6.4",
        "@storybook/test": "^8.6.4",
        "@types/insane": "^1.0.0",
        "@types/node": "^22.13.10",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@typescript-eslint/parser": "^8.26.1",
        "@vitejs/plugin-react": "^4.3.4",
        "concurrently": "^9.1.2",
        "copyfiles": "^2.4.1",
        "eslint": "^9.22.0",
        "globals": "^16.0.0",
        "lefthook": "^1.11.3",
        "prettier": "^3.5.3",
        "prettier-plugin-css-order": "^2.1.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "sass": "^1.85.1",
        "storybook": "^8.6.4",
        "typescript": "^5.8.2",
        "vite": "^6.2.1",
        "vite-tsconfig-paths": "^5.1.4",
        "watch": "^1.0.2"
    },
    "dependencies": {
        "insane": "^2.6.2",
        "marked": "^15.0.7"
    }
}
