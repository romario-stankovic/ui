{
    "name": "@romario-stankovic/ui2",
    "version": "0.0.0",
    "private": true,
    "description": "UI library",
    "type": "module",
    "files": [
        "packages"
    ],
    "exports": {
        "./react": {
            "types": "./packages/react/dist/index.d.ts",
            "import": "./packages/react/dist/index.js",
            "require": "./packages/react/dist/index.umd.cjs"
        },
        "./vue": {
            "types": "./packages/vue/dist/index.d.ts",
            "import": "./packages/vue/dist/index.js",
            "require": "./packages/vue/dist/index.umd.cjs"
        },
        "./vue/style.css": "./packages/vue/dist/index.css"
    },
    "scripts": {
        "dev": "concurrently \"npm run dev:mitosis\" \"npm run dev:storybook\"",
        "build": "npm run build:mitosis && npm run build:copy && concurrently \"npm run build:react\" \"npm run build:vue\"",
        "dev:mitosis": "watch \"npm run build:mitosis\" ./src",
        "dev:storybook": "storybook dev -p 6006 --no-open",
        "build:storybook": "storybook build",
        "build:mitosis": "mitosis build --c mitosis.config.cjs",
        "build:copy": "copyfiles -u 1 assets/**/* packages",
        "build:react": "cd packages/react && npm i",
        "build:vue": "cd packages/vue && npm i",
        "lint": "eslint --fix",
        "format": "prettier --write .",
        "prepublish": "npm run build"
    },
    "devDependencies": {
        "@builder.io/eslint-plugin-mitosis": "^0.0.16",
        "@builder.io/mitosis": "^0.6.4",
        "@builder.io/mitosis-cli": "^0.6.4",
        "@chromatic-com/storybook": "^3.2.5",
        "@eslint/eslintrc": "^3.3.0",
        "@eslint/js": "^9.21.0",
        "@fortawesome/fontawesome-svg-core": "^6.7.2",
        "@fortawesome/free-brands-svg-icons": "^6.7.2",
        "@fortawesome/free-regular-svg-icons": "^6.7.2",
        "@fortawesome/free-solid-svg-icons": "^6.7.2",
        "@fortawesome/react-fontawesome": "^0.2.2",
        "@iconify-icon/react": "^2.3.0",
        "@storybook/addon-essentials": "^8.6.1",
        "@storybook/addon-interactions": "^8.6.1",
        "@storybook/addon-onboarding": "^8.6.1",
        "@storybook/blocks": "^8.6.1",
        "@storybook/react": "^8.6.1",
        "@storybook/react-vite": "^8.6.1",
        "@storybook/test": "^8.6.1",
        "@types/node": "^22.13.5",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@typescript-eslint/parser": "^8.25.0",
        "@vitejs/plugin-react": "^4.3.4",
        "concurrently": "^9.1.2",
        "copyfiles": "^2.4.1",
        "eslint": "^9.21.0",
        "globals": "^16.0.0",
        "lefthook": "^1.11.2",
        "prettier": "^3.5.2",
        "prettier-plugin-css-order": "^2.1.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "sass": "^1.85.1",
        "storybook": "^8.6.1",
        "typescript": "^5.7.3",
        "vite": "^6.2.0",
        "vite-tsconfig-paths": "^5.1.4",
        "watch": "^1.0.2"
    }
}
